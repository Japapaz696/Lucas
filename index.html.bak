<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lucas — Sites, Sistemas e Soluções Digitais</title>
    <meta name="description" content="Desenvolvimento de sites profissionais, sistemas web e integrações inteligentes. Orçamento interativo com preço em tempo real.">
    <meta name="author" content="Lucas">

    <!-- Open Graph -->
    <meta property="og:title" content="Lucas — Sites, Sistemas e Soluções Digitais">
    <meta property="og:description" content="Desenvolvimento de sites profissionais, sistemas web e integrações inteligentes.">
    <meta property="og:type" content="website">

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="imagens/favicon.svg">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@400;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <!-- Stylesheet -->
    <link rel="stylesheet" href="styles.css">

    <!-- SEO -->
    <meta name="robots" content="index, follow">
    <meta name="language" content="Portuguese">
    <meta name="geo.region" content="BR">

    <!-- Schema.org LocalBusiness -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Lucas — Desenvolvimento Web",
        "description": "Desenvolvimento de sites profissionais, sistemas web e integrações inteligentes.",
        "url": "https://lucassite.com",
        "telephone": "+55-31-97340-3545",
        "areaServed": { "@type": "Country", "name": "Brasil" },
        "priceRange": "R$ 150–750+"
    }
    </script>
</head>
<body>

    <!-- Header -->
    <header class="header" role="banner">
        <div class="header-inner">
            <div class="logo-mark" title="Página inicial">
                Lucas
            </div>
            <button class="mobile-menu-toggle" aria-label="Abrir menu" aria-expanded="false">
                <span></span>
                <span></span>
                <span></span>
            </button>
            <nav class="nav-links" role="navigation" aria-label="Navegação principal">
                <a href="#home" class="nav-link" data-section="home">Início</a>
                <a href="#servicos" class="nav-link" data-section="servicos">Serviços</a>
                <a href="#como-funciona" class="nav-link" data-section="como-funciona">Como Funciona</a>
                <a href="#orcamento" class="nav-link" data-section="orcamento">Orçamento</a>
                <a href="#projetos" class="nav-link" data-section="projetos">Projetos</a>
                <a href="#contato" class="nav-link" data-section="contato">Contato</a>
            </nav>
        </div>
    </header>

    <!-- Hero -->
    <section id="home" class="hero" role="banner" aria-label="Abertura da página">
        <img src="imagens/fundo do site.jpg" alt="" class="hero-bg-img" loading="eager">
        <div class="hero-bg-overlay" aria-hidden="true"></div>

        <div class="hero-inner">
            <span class="hero-tagline">Sites • Sistemas • Integrações • IA</span>
            <h1>Sites e sistemas que geram <em>contato</em> e <em>resultado</em></h1>
            <p class="hero-desc">
                Desenvolvimento web profissional sob medida. Landing pages, sites institucionais, sistemas com painel administrativo e automações inteligentes.
            </p>
            <div class="hero-cta-row">
                <a href="#orcamento" class="btn-primary">Solicitar orçamento</a>
                <a href="#projetos" class="btn-ghost">Ver trabalhos</a>
            </div>
        </div>
    </section>

    <!-- Serviços -->
    <section id="servicos" class="section-services" data-section="servicos">
        <div class="section-label" data-reveal data-reveal-delay="0.1">Serviços</div>
        <h2 class="section-title" data-reveal data-reveal-delay="0.2">O que eu faço</h2>
        <p class="section-sub" data-reveal data-reveal-delay="0.3">Soluções digitais sob medida para transformar sua ideia em um produto que funciona e converte.</p>

        <div class="services-list">
            <article class="service-row" data-reveal data-reveal-delay="0.4">
                <span class="service-index">01</span>
                <div class="service-copy">
                    <h3>Sites profissionais</h3>
                    <p>Presença comercial completa: páginas, identidade visual e estrutura pensada para gerar contato.</p>
                </div>
            </article>
            <article class="service-row" data-reveal data-reveal-delay="0.45">
                <span class="service-index">02</span>
                <div class="service-copy">
                    <h3>Landing pages</h3>
                    <p>Uma página, uma oferta, um caminho claro até o WhatsApp ou o formulário.</p>
                </div>
            </article>
            <article class="service-row" data-reveal data-reveal-delay="0.5">
                <span class="service-index">03</span>
                <div class="service-copy">
                    <h3>Sistemas web</h3>
                    <p>Login, cadastro, painel e regras do seu negócio — sem template genérico.</p>
                </div>
            </article>
            <article class="service-row" data-reveal data-reveal-delay="0.55">
                <span class="service-index">04</span>
                <div class="service-copy">
                    <h3>Agendamentos</h3>
                    <p>Agenda online, confirmação automática e painel de horários para clínicas e serviços.</p>
                </div>
            </article>
            <article class="service-row" data-reveal data-reveal-delay="0.6">
                <span class="service-index">05</span>
                <div class="service-copy">
                    <h3>E-commerce</h3>
                    <p>Catálogo, carrinho e canal de pagamento para vender com clareza e sem fricção.</p>
                </div>
            </article>
            <article class="service-row" data-reveal data-reveal-delay="0.65">
                <span class="service-index">06</span>
                <div class="service-copy">
                    <h3>Automações</h3>
                    <p>WhatsApp, n8n, notificações e fluxos que rodam sozinhos depois da entrega.</p>
                </div>
            </article>
            <article class="service-row" data-reveal data-reveal-delay="0.7">
                <span class="service-index">07</span>
                <div class="service-copy">
                    <h3>Projetos personalizados</h3>
                    <p>Escopo sob medida quando o que você precisa não cabe em um pacote pronto.</p>
                </div>
            </article>
        </div>
    </section>

    <!-- Como Funciona -->
    <section id="como-funciona" class="section-work" data-section="como-funciona">
        <div class="section-label" data-reveal data-reveal-delay="0.1">Como Funciona</div>
        <h2 class="section-title" data-reveal data-reveal-delay="0.2">Do contato ao projeto entregue</h2>
        <p class="section-sub" data-reveal data-reveal-delay="0.3">Processo simples e transparente para você ter clareza de escopo, prazo e custo desde o início.</p>

        <div class="steps-row">
            <div class="step-item" data-reveal data-reveal-delay="0.4">
                <div class="step-num">1</div>
                <h4>Você monta o projeto</h4>
                <p>Use o orçamento interativo para escolher tipo, páginas e funcionalidades. Ou descreva livremente como imagina.</p>
            </div>
            <div class="step-item" data-reveal data-reveal-delay="0.5">
                <div class="step-num">2</div>
                <h4>Apresento a solução</h4>
                <p>Releio sua descrição, afino o escopo e envio uma proposta clara com cronograma e etapas definidas.</p>
            </div>
            <div class="step-item" data-reveal data-reveal-delay="0.6">
                <div class="step-num">3</div>
                <h4>Desenvolvo</h4>
                <p>Código limpo, testes funcionais e comunicação direta durante toda a implementação. Você acompanha o progresso.</p>
            </div>
            <div class="step-item" data-reveal data-reveal-delay="0.7">
                <div class="step-num">4</div>
                <h4>Entrego</h4>
                <p>Projeto funcional, documentação básica e suporte por 30 dias. Treinamento opcional para sua equipe.</p>
            </div>
        </div>
    </section>

    <!-- Orçamento -->
    <section id="orcamento" class="section-budget" data-section="orcamento">
        <div class="section-label" data-reveal data-reveal-delay="0.1">Orçamento Interativo</div>
        <h2 class="section-title" data-reveal data-reveal-delay="0.2">Monte seu projeto</h2>
        <p class="section-sub" data-reveal data-reveal-delay="0.3">Arraste o controle ou escolha os recursos. O preço atualiza em tempo real — sem surpresas.</p>

        <!-- Slider de controle -->
        <div class="budget-slider-wrap" data-reveal data-reveal-delay="0.35">
            <div class="slider-labels">
                <span>R$ 0</span>
                <span>R$ 150</span>
                <span>R$ 300</span>
                <span>R$ 450</span>
                <span>R$ 600</span>
                <span>R$ 750+</span>
            </div>
            <input
                type="range"
                id="budget-slider"
                class="budget-slider"
                min="0"
                max="750"
                value="0"
                step="1"
                aria-label="Valor do orçamento">
            <div class="slider-value-display">
                <span id="price-display">R$ 0</span>
                <span id="price-note" class="price-note">Arraste o controle ou escolha um tipo de projeto</span>
            </div>
        </div>

        <div class="budget-box">
            <!-- Configurador -->
            <div class="config-panel" data-reveal data-reveal-delay="0.4">

                <div class="config-group">
                    <h3>Tipo de Projeto</h3>
                    <div class="option-row" role="radiogroup" aria-label="Tipo de projeto">
                        <button class="option-btn" data-type="landing" role="radio" aria-checked="false">Landing Page</button>
                        <button class="option-btn" data-type="profissional" role="radio" aria-checked="false">Site Profissional</button>
                        <button class="option-btn" data-type="avancado" role="radio" aria-checked="false">Site Avançado</button>
                        <button class="option-btn" data-type="loja" role="radio" aria-checked="false">Loja Virtual</button>
                        <button class="option-btn" data-type="agendamento" role="radio" aria-checked="false">Sistema de Agendamento</button>
                        <button class="option-btn" data-type="sistema" role="radio" aria-checked="false">Sistema Personalizado</button>
                        <button class="option-btn" data-type="personalizado" role="radio" aria-checked="false">Sob Medida</button>
                    </div>
                </div>

                <div class="config-group">
                    <h3>Páginas</h3>
                    <div class="option-row" role="group" aria-label="Páginas">
                        <button class="option-btn selected" data-page="home" role="checkbox" aria-checked="true">Home</button>
                        <button class="option-btn" data-page="sobre" role="checkbox" aria-checked="false">Sobre</button>
                        <button class="option-btn" data-page="servicos" role="checkbox" aria-checked="false">Serviços</button>
                        <button class="option-btn" data-page="contato" role="checkbox" aria-checked="false">Contato</button>
                        <button class="option-btn" data-page="blog" role="checkbox" aria-checked="false">Blog</button>
                        <button class="option-btn" data-page="faq" role="checkbox" aria-checked="false">FAQ</button>
                        <button class="option-btn" data-page="galeria" role="checkbox" aria-checked="false">Galeria</button>
                        <button class="option-btn" data-page="depoimentos" role="checkbox" aria-checked="false">Depoimentos</button>
                    </div>
                </div>

                <div class="config-group">
                    <h3>Recursos</h3>
                    <div class="option-row" role="group" aria-label="Recursos">
                        <button class="option-btn selected" data-func="responsivo" role="checkbox" aria-checked="true">Responsivo</button>
                        <button class="option-btn selected" data-func="whatsapp" role="checkbox" aria-checked="true">WhatsApp</button>
                        <button class="option-btn" data-func="formulario" role="checkbox" aria-checked="false">Formulário</button>
                        <button class="option-btn" data-func="agendamento" role="checkbox" aria-checked="false">Agendamento</button>
                        <button class="option-btn" data-func="login" role="checkbox" aria-checked="false">Login</button>
                        <button class="option-btn" data-func="cadastro" role="checkbox" aria-checked="false">Cadastro</button>
                        <button class="option-btn" data-func="admin" role="checkbox" aria-checked="false">Área Admin</button>
                        <button class="option-btn" data-func="dashboard" role="checkbox" aria-checked="false">Dashboard</button>
                        <button class="option-btn" data-func="database" role="checkbox" aria-checked="false">Banco de Dados</button>
                        <button class="option-btn" data-func="seo" role="checkbox" aria-checked="false">SEO</button>
                        <button class="option-btn" data-func="animacoes" role="checkbox" aria-checked="false">Animações</button>
                        <button class="option-btn" data-func="pwa" role="checkbox" aria-checked="false">PWA</button>
                    </div>
                </div>

                <div class="config-group">
                    <h3>Integrações</h3>
                    <div class="option-row" role="group" aria-label="Integrações">
                        <button class="option-btn" data-int="whatsappApi" role="checkbox" aria-checked="false">WhatsApp API</button>
                        <button class="option-btn" data-int="email" role="checkbox" aria-checked="false">E-mail</button>
                        <button class="option-btn" data-int="api" role="checkbox" aria-checked="false">API Externa</button>
                        <button class="option-btn" data-int="maps" role="checkbox" aria-checked="false">Google Maps</button>
                        <button class="option-btn" data-int="pagamento" role="checkbox" aria-checked="false">Pagamento</button>
                        <button class="option-btn" data-int="crm" role="checkbox" aria-checked="false">CRM</button>
                        <button class="option-btn" data-int="automacao" role="checkbox" aria-checked="false">Automação</button>
                    </div>
                </div>

                <div class="config-group">
                    <h3>Inteligência Artificial</h3>
                    <div class="option-row" role="group" aria-label="IA">
                        <button class="option-btn" data-ia="chatbot" role="checkbox" aria-checked="false">Chatbot</button>
                        <button class="option-btn" data-ia="atendimento" role="checkbox" aria-checked="false">Atendimento com IA</button>
                        <button class="option-btn" data-ia="agente" role="checkbox" aria-checked="false">Agente de IA</button>
                        <button class="option-btn" data-ia="conteudo" role="checkbox" aria-checked="false">Geração de Conteúdo</button>
                        <button class="option-btn" data-ia="autoIa" role="checkbox" aria-checked="false">Automação Inteligente</button>
                    </div>
                </div>

                <div class="config-group">
                    <h3>Automações</h3>
                    <div class="option-row" role="group" aria-label="Automações">
                        <button class="option-btn" data-auto="n8n" role="checkbox" aria-checked="false">n8n</button>
                        <button class="option-btn" data-auto="fluxos" role="checkbox" aria-checked="false">Fluxos Automatizados</button>
                        <button class="option-btn" data-auto="notificacoes" role="checkbox" aria-checked="false">Notificações</button>
                        <button class="option-btn" data-auto="processos" role="checkbox" aria-checked="false">Processos Automáticos</button>
                    </div>
                </div>

                <div class="config-group">
                    <h3>Extras</h3>
                    <div class="option-row" role="group" aria-label="Extras">
                        <button class="option-btn" data-extra="suporte" role="checkbox" aria-checked="false">Suporte Mensal</button>
                        <button class="option-btn" data-extra="treinamento" role="checkbox" aria-checked="false">Treinamento</button>
                        <button class="option-btn" data-extra="docs" role="checkbox" aria-checked="false">Documentação</button>
                    </div>
                </div>

                <!-- Resumo -->
                <div class="project-summary" id="project-summary">
                    <h4>Resumo do Projeto</h4>
                    <div class="summary-tag" data-summary="type">Tipo: <span>—</span></div>
                    <div class="summary-tag" data-summary="pages">Páginas: <span>—</span></div>
                    <div class="summary-tag" data-summary="features">Recursos: <span>—</span></div>
                    <div class="summary-tag" data-summary="integrations">Integrações: <span>—</span></div>
                    <div class="summary-tag" data-summary="ia">IA: <span>—</span></div>
                    <div class="summary-tag" data-summary="automation">Automação: <span>—</span></div>
                    <div class="summary-tag" data-summary="extras">Extras: <span>—</span></div>
                </div>

                <!-- IA dentro do orçamento -->
                <div class="ai-mini">
                    <p class="ai-mini-label">Não sabe por onde começar?</p>
                    <textarea
                        id="ai-description"
                        placeholder="Ex: 'Quero um site para minha clínica onde meus clientes possam marcar consultas e receber confirmação pelo WhatsApp.'"
                        rows="4"
                        maxlength="1000"></textarea>
                    <button class="ai-btn" type="button" id="ai-suggest-btn">Sugerir com base na descrição</button>
                    <p class="ai-result" id="ai-result"></p>
                </div>
            </div>

            <!-- Mini-site do projeto (evolutivo) -->
            <div class="project-preview-panel" data-reveal data-reveal-delay="0.5">
                <h3>Seu projeto visual</h3>
                <div id="mini-site-container" class="mini-site-container" data-tier="empty">
                    <div class="mini-empty-state">
                        <span>Arraste o controle para ver o site nascer</span>
                    </div>
                    <div id="mini-header" class="mini-site-header">
                        <div class="mini-logo">Lucas</div>
                        <nav class="mini-nav">
                            <a href="#home" class="mini-nav-link">Início</a>
                            <a href="#servicos" class="mini-nav-link">Serviços</a>
                            <a href="#orcamento" class="mini-nav-link">Orçamento</a>
                        </nav>
                    </div>

                    <div id="mini-hero" class="mini-site-hero">
                        <div class="mini-hero-content">
                            <h1>Construindo seu projeto digital</h1>
                            <p>Seu site está tomando forma conforme você escolhe os recursos</p>
                            <div class="mini-progress-indicator">
                                <span>Nível de projeto: <strong id="mini-tier-label">Nenhum</strong></span>
                            </div>
                        </div>
                    </div>

                    <div id="mini-services" class="mini-site-services">
                        <h2>Serviços</h2>
                        <div class="mini-services-grid">
                            <div class="mini-service-item">Landing Pages</div>
                            <div class="mini-service-item">Sites Profissionais</div>
                            <div class="mini-service-item">Sistemas Web</div>
                        </div>
                    </div>

                    <div id="mini-features" class="mini-site-features">
                        <h2>Recursos principais</h2>
                        <div class="mini-features-list">
                            <div class="mini-feature-item">Responsividade</div>
                            <div class="mini-feature-item">Botão WhatsApp</div>
                            <div class="mini-feature-item">Formulário de contato</div>
                        </div>
                    </div>

                    <div id="mini-cards" class="mini-site-cards">
                        <div class="mini-card">
                            <div class="mini-card-icon">⚡</div>
                            <div class="mini-card-title">Performance</div>
                            <div class="mini-card-desc">Sites rápidos e otimizados</div>
                        </div>
                        <div class="mini-card">
                            <div class="mini-card-icon">🔒</div>
                            <div class="mini-card-title">Segurança</div>
                            <div class="mini-card-desc">Proteção de dados e SSL</div>
                        </div>
                        <div class="mini-card">
                            <div class="mini-card-icon">📈</div>
                            <div class="mini-card-title">SEO</div>
                            <div class="mini-card-desc">Otimizado para buscas</div>
                        </div>
                    </div>

                    <div id="mini-form-section" class="mini-site-form-section">
                        <h2>Entre em contato</h2>
                        <form class="mini-contact-form">
                            <div class="form-group">
                                <label for="mini-name">Nome</label>
                                <input type="text" id="mini-name" placeholder="Seu nome">
                            </div>
                            <div class="form-group">
                                <label for="mini-whatsapp">WhatsApp</label>
                                <input type="tel" id="mini-whatsapp" placeholder="(XX) XXXXX-XXXX">
                            </div>
                            <div class="form-group">
                                <label for="mini-project-type">Tipo de Projeto</label>
                                <select id="mini-project-type">
                                    <option value="">Selecione...</option>
                                    <option value="site">Site Institucional</option>
                                    <option value="landing">Landing Page</option>
                                    <option value="loja">Loja Virtual</option>
                                    <option value="agendamento">Sistema de Agendamento</option>
                                    <option value="personalizado">Personalizado</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="mini-message">Mensagem</label>
                                <textarea id="mini-message" placeholder="Descreva seu projeto..." rows="4"></textarea>
                            </div>
                            <button type="submit" class="mini-submit-btn">Solicitar orçamento</button>
                        </form>
                    </div>

                    <div id="mini-contact-info" class="mini-site-contact-info">
                        <h2>Contate-nos</h2>
                        <div class="mini-contact-details">
                            <div class="mini-contact-item">
                                <strong>Email:</strong> contato@lucasdev.com
                            </div>
                            <div class="mini-contact-item">
                                <strong>WhatsApp:</strong> (31) 97340-3545
                            </div>
                            <div class="mini-contact-item">
                                <strong>Atendimento:</strong> Seg-Sex, 9h-18h
                            </div>
                        </div>
                    </div>

                    <div id="mini-footer" class="mini-site-footer">
                        <div class="mini-footer-content">
                            <p>© 2026 Lucas — Desenvolvimento Web</p>
                            <div class="mini-footer-links">
                                <a href="#home">Início</a>
                                <a href="#servicos">Serviços</a>
                                <a href="#orcamento">Orçamento</a>
                                <a href="#contato">Contato</a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Barra de complexidade -->
                <div class="complexity-bar" id="complexity-bar">
                    <span></span><span></span><span></span><span></span>
                </div>
                <div class="complexity-label" id="complexity-label">Complexidade: —</div>

                <!-- Faixas -->
                <div id="price-range" class="price-range-label">
                    Arraste o controle ou escolha um tipo para ver a estimativa
                </div>

                <!-- Lista de evolução -->
                <div class="evolution-tracker">
                    <h4>Seu site está sendo construído</h4>
                    <div class="evolution-list">
                        <div class="evolution-item" id="evo-header">✓ Estrutura inicial</div>
                        <div class="evolution-item" id="evo-responsive">✓ Design responsivo</div>
                        <div class="evolution-item" id="evo-hero">✓ Hero</div>
                        <div class="evolution-item" id="evo-services">✓ Serviços</div>
                        <div class="evolution-item" id="evo-features">✓ Recursos</div>
                        <div class="evolution-item" id="evo-cards">✓ Cards / conteúdo</div>
                        <div class="evolution-item" id="evo-form">✓ Formulário</div>
                        <div class="evolution-item" id="evo-contact">✓ Contato</div>
                        <div class="evolution-item" id="evo-whatsapp">✓ WhatsApp</div>
                        <div class="evolution-item" id="evo-seo">✓ SEO</div>
                        <div class="evolution-item" id="evo-booking">✓ Agendamento</div>
                        <div class="evolution-item" id="evo-footer">✓ Rodapé</div>
                    </div>
                </div>

                <!-- WhatsApp CTA -->
                <a
                    id="whatsapp-cta"
                    class="btn-primary whatsapp-cta-btn"
                    href="#"
                    target="_blank"
                    rel="noopener"
                    style="width:100%; justify-content:center; margin-top:1.5rem;">
                    SOLICITAR NO WHATSAPP
                </a>
            </div>
        </div>
    </section>

    <!-- Projetos -->
    <section id="projetos" class="section-projects" data-section="projetos">
        <div class="section-label" data-reveal data-reveal-delay="0.1">Projetos</div>
        <h2 class="section-title" data-reveal data-reveal-delay="0.2">Trabalhos recentes</h2>
        <p class="section-sub" data-reveal data-reveal-delay="0.3">Projetos reais que mostram a variedade de soluções entregue. Cada um resolve um problema específico.</p>

        <div class="project-grid">
            <!-- Site Veronica — consultório/psicologia -->
            <article class="project-card" data-reveal data-reveal-delay="0.4">
                <div class="project-cover cover-veronica">
                    <div class="cover-inner">
                        <div class="cover-nav"></div>
                        <div class="cover-hero-text">
                            <div class="cover-chip">Psicologia</div>
                            <div class="cover-title"></div>
                            <div class="cover-sub"></div>
                        </div>
                        <div class="cover-agenda">
                            <div class="cover-agenda-day"></div>
                            <div class="cover-slots">
                                <span></span><span></span><span></span>
                            </div>
                        </div>
                    </div>
                    <div class="project-tag">Site Completo</div>
                </div>
                <div class="project-body">
                    <h3>Site da Veronica</h3>
                    <p class="project-meta">Psicologia • Consultório</p>
                    <p>Site profissional com portfólio, sistema de agendamento online com confirmação pelo WhatsApp e painel administrativo para gestão de horários e pacientes.</p>
                    <a href="https://site-veronica.onrender.com" class="project-link" target="_blank" rel="noopener">
                        Ver projeto <span>→</span>
                    </a>
                </div>
            </article>

            <!-- Sistema de Agendamento -->
            <article class="project-card" data-reveal data-reveal-delay="0.5">
                <div class="project-cover cover-agendamento">
                    <div class="cover-inner">
                        <div class="cover-nav"></div>
                        <div class="cover-calendar">
                            <div class="cover-cal-head"></div>
                            <div class="cover-cal-grid">
                                <div></div><div></div><div></div><div></div>
                                <div></div><div></div><div></div>
                            </div>
                        </div>
                        <div class="cover-sidebar">
                            <div class="cover-sb-item"></div>
                            <div class="cover-sb-item"></div>
                            <div class="cover-sb-item"></div>
                        </div>
                    </div>
                    <div class="project-tag">Sistema Web</div>
                </div>
                <div class="project-body">
                    <h3>Sistema de Agendamento</h3>
                    <p class="project-meta">Automação • Gestão de Horários</p>
                    <p>Sistema completo com agenda inteligente, confirmação automática, painel do prestador e painel do cliente. Integra com WhatsApp para notificações.</p>
                    <a href="https://site-veronica.onrender.com" class="project-link" target="_blank" rel="noopener">
                        Ver projeto <span>→</span>
                    </a>
                </div>
            </article>

            <!-- Loja Virtual -->
            <article class="project-card" data-reveal data-reveal-delay="0.6">
                <div class="project-cover cover-loja">
                    <div class="cover-inner">
                        <div class="cover-nav"></div>
                        <div class="cover-hero-text">
                            <div class="cover-chip">E-commerce</div>
                            <div class="cover-title"></div>
                            <div class="cover-sub"></div>
                        </div>
                        <div class="cover-3col">
                            <div class="cover-col-block"></div>
                            <div class="cover-col-block"></div>
                            <div class="cover-col-block"></div>
                        </div>
                    </div>
                    <div class="project-tag">Loja Virtual</div>
                </div>
                <div class="project-body">
                    <h3>Loja Com Produtos e Carrinho</h3>
                    <p class="project-meta">E-commerce • Pagamento • Catálogo</p>
                    <p>Catálogo de produtos, página individual, carrinho de compras e integração com pagamento. Responsivo, com busca, filtros e checkout simplificado.</p>
