    <!-- CTA Final -->
    <section id="cta" class="section-cta">
        <div class="section-label" data-reveal data-reveal-delay="0.1">Pronto para começar?</div>
        <h2 class="section-title" data-reveal data-reveal-delay="0.2">Vamos transformar sua ideia em projeto</h2>
        <p class="section-sub" data-reveal data-reveal-delay="0.3">Monte seu orçamento no configurador acima ou fale diretamente no WhatsApp. Resposta rápida garantida.</p>
        <a
            id="whatsapp-cta-final"
            href="#"
            class="btn-primary whatsapp-cta-btn"
            target="_blank"
            rel="noopener"
            data-reveal data-reveal-delay="0.4">
            SOLICITAR ORÇAMENTO NO WHATSAPP
        </a>
    </section>

    <!-- Contato -->
    <section id="contato" class="section-contact" data-section="contato">
        <div class="section-label" data-reveal data-reveal-delay="0.1">Contato</div>
        <h2 class="section-title" data-reveal data-reveal-delay="0.2">Vamos conversar</h2>

        <div class="contact-layout">
            <div class="contact-info-panel" data-reveal data-reveal-delay="0.3">
                <h3>Pronto para transformar sua ideia em projeto?</h3>
                <p class="contact-intro">Prefere explicar o projeto por escrito? Descreva o que precisa, o público-alvo e o que já tem. Respondo com uma proposta clara, sem pressa.</p>
                <p class="contact-alternative">Ou agende uma conversa rápida direto pelo WhatsApp — a resposta é imediata.</p>

                <div class="contact-details">
                    <div class="contact-detail-item">
                        <strong class="detail-label">E-mail</strong>
                        <span class="detail-value">contato@lucasdev.com</span>
                    </div>
                    <div class="contact-detail-item">
                        <strong class="detail-label">WhatsApp</strong>
                        <span class="detail-value">+55 (31) 97340-3545</span>
                    </div>
                    <div class="contact-detail-item">
                        <strong class="detail-label">Disponibilidade</strong>
                        <span class="detail-value">Seg–Sex, 9h–18h</span>
                    </div>
                </div>

                <a id="whatsapp-cta-contact" href="#" class="btn-primary whatsapp-cta-btn" target="_blank" rel="noopener">
                    Enviar mensagem no WhatsApp
                </a>
            </div>

            <div class="contact-form-panel" data-reveal data-reveal-delay="0.4">
                <form id="contact-form" class="contact-form" action="#" method="POST">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="contact-name">Nome</label>
                            <input type="text" id="contact-name" name="name" placeholder="Seu nome completo" required>
                        </div>
                        <div class="form-group">
                            <label for="contact-whatsapp">WhatsApp</label>
                            <input type="tel" id="contact-whatsapp" name="whatsapp" placeholder="(31) 9XXXX-XXXX" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="contact-project-type">Tipo de projeto</label>
                        <select id="contact-project-type" name="project_type" required>
                            <option value="">Selecione...</option>
                            <option value="site">Site institucional</option>
                            <option value="landing">Landing page</option>
                            <option value="loja">Loja virtual</option>
                            <option value="sistema">Sistema web</option>
                            <option value="agendamento">Sistema de agendamento</option>
                            <option value="personalizado">Projeto personalizado</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="contact-message">Mensagem</label>
                        <textarea id="contact-message" name="message" rows="4" placeholder="Descreva seu projeto ou dúvida..." required></textarea>
                    </div>

                    <button id="contact-submit" type="submit" class="btn-primary contact-submit-btn">
                        SOLICITAR ORÇAMENTO
                    </button>
                </form>
            </div>
        </div>
    </section>

